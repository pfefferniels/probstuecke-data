    <music>
        <body>
            <mdiv>
                <score>
                    <scoreDef key.pname="b" key.accid="f" key.mode="major" midi.bpm="100" mnum.visible="false">
                        <staffGrp>
                            <staffDef xml:id="rh" n="1" lines="5">
                                <clef line="1" shape="C" />
                                <keySig sig="1f" />
                                <meterSig count="9" unit="16" form="invis" />
                            </staffDef>
                            <staffDef xml:id="lh" n="2" lines="5">
                                <clef line="4" shape="F" />
                                <keySig sig="1f" />
                                <meterSig count="9" unit="16" form="invis" />
                            </staffDef>
                        </staffGrp>
                    </scoreDef>
                    <section>
                        <choice>
                            <orig />
                            <reg resp="#pfeffer">
                                <scoreDef>
                                    <keySig sig="2f" />
                                    <staffGrp>
                                        <staffDef n="1">
                                            <clef line="2" shape="G" />
                                        </staffDef>
                                    </staffGrp>
                                </scoreDef>
                            </reg>
                        </choice>
                        <measure n="1">
                            <staff n="1">
                                <layer n="1">
                                    <beam place="below">
                                        <note dur="16" oct="4" pname="g" />
                                        <note dur="16" oct="5" pname="e">
                                            <orig>
                                                <accid accid="f" />
                                            </orig>
                                        </note>
                                        <note dur="16" oct="5" pname="e" accid.ges="f" />
                                    </beam>
                                    <beam place="below">
                                        <note dur="16" oct="4" pname="g" />
                                        <note dur="16" oct="5" pname="e" accid.ges="f">
                                            <!-- B (later printing): flat in the staff -->
                                            <app type="reprint">
                                                <lem source="#secondEdition" />
                                                <rdg source="#secondEditionReprint">
                                                    <orig>
                                                        <accid accid="f" />
                                                    </orig>
                                                </rdg>
                                            </app>
                                        </note>
                                        <note dur="16" oct="5" pname="e" accid.ges="f" />
                                    </beam>
                                    <beam place="below">
                                        <note dur="16" oct="4" pname="g" />
                                        <note dur="16" oct="5" pname="e" accid.ges="f">
                                            <!-- B (later printing): flat in the staff -->
                                            <app type="reprint">
                                                <lem source="#secondEdition" />
                                                <rdg source="#secondEditionReprint">
                                                    <orig>
                                                        <accid accid="f" />
                                                    </orig>
                                                </rdg>
                                            </app>
                                        </note>
                                        <note dur="16" oct="5" pname="e" accid.ges="f" />
                                    </beam>
                                </layer>
                            </staff>
                            <staff n="2">
                                <layer n="1">
                                    <beam>
                                        <note dots="1" dur="8" oct="3" pname="c" />
                                        <note dots="1" dur="8" oct="4" pname="c" />
                                        <note dots="1" dur="8" oct="3" pname="c" />
                                    </beam>
                                </layer>
                            </staff>
                        </measure>
                        <measure n="2">
                            <staff n="1">
                                <layer n="1">
                                    <beam place="below">
                                        <note dur="16" oct="5" pname="d" />
                                        <note dur="16" oct="4" pname="g" />
                                        <note dur="16" oct="4" pname="g" />
                                    </beam>
                                    <beam place="below">
                                        <note dur="16" oct="5" pname="d" />
                                        <note dur="16" oct="4" pname="g" />
                                        <note dur="16" oct="4" pname="g" />
                                    </beam>
                                    <beam place="below">
                                        <note dur="16" oct="5" pname="d" />
                                        <note dur="16" oct="4" pname="g" />
                                        <note dur="16" oct="4" pname="g" />
                                    </beam>
                                </layer>
                            </staff>
                            <staff n="2">
                                <layer n="1">
                                    <beam>
                                        <note dots="1" dur="8" oct="3" pname="b" accid.ges="f" />
                                        <note dots="1" dur="8" oct="2" pname="b" accid.ges="f" />
                                        <note dots="1" dur="8" oct="3" pname="b" accid.ges="f" />
                                    </beam>
                                </layer>
                            </staff>
                        </measure>
                    </section>
                </score>
            </mdiv>
        </body>
    </music>
