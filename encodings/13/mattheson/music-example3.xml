                    <useRestrict label="licence" auth="https://creativecommons.org/licenses/by/" codedval="4.0">
                        <p>Creative Commons Attribution 4.0 International License</p>
                    </useRestrict>
                </availability>
            </pubStmt>
            <sourceDesc>
                <source xml:id="secondEditionReprint" type="reprint">
                    <bibl>
                        <title type="uniform">Grosse General-Baß-Schule</title>
                        <corpName role="publisher">Kißner</corpName>
                        <pubPlace>Hamburg</pubPlace>
                        <annot>A later printing of the print of 1731, undated and set anew from it (VD18 12997536): title page
                          in black only, 460 pages, the errata of 1731 applied. Cited from the copy in Hamburg.</annot>
                        <corpName role="repository">Staats- und Universitätsbibliothek Hamburg</corpName>
